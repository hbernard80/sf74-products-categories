{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - {{ parent() }}{% endblock %}

{% block body %}
    {% import 'macros/buttons.html.twig' as buttons %}

    <h1 class="mb-3">Catégorie : {{ category.name }}</h1>

    <div class="table-responsive">
        <table class="table table-bordered table-hover table-striped">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ category.id }}</td>
                </tr>
                <tr>
                    <th>Nom</th>
                    <td>{{ category.name }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ category.description }}</td>
                </tr>
                <tr>
                    <th>Catégorie parente</th>
                    <td>
                        {% if category.parent %}
                            <a href="{{ path('app_category_show', {'id': category.parent.id}) }}">{{ category.parent.name }}</a>
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Sous-catégories</th>
                    <td>
                        {% for child in category.children %}
                            <a href="{{ path('app_category_show', {'id': child.id}) }}">{{ child.name }}</a>{% if not loop.last %}, {% endif %}
                        {% else %}
                            -
                        {% endfor %}
                    </td>
                </tr>
                <tr>
                    <th>Produits associés</th>
                    <td>
                        {% for product in category.products %}
                            <a href="{{ path('app_product_show', {'id': product.id}) }}">{{ product.name }}</a>{% if not loop.last %}, {% endif %}
                        {% else %}
                            -
                        {% endfor %}
                    </td>
                </tr>
                <tr>
                    <th>Créée le</th>
                    <td>{{ category.createdAt ? category.createdAt|date('d/m/Y H\\hi') : '' }}</td>
                </tr>
                {% if category.createdAt != category.updatedAt %}
                    <tr>
                        <th>Modifiée le</th>
                        <td>{{ category.updatedAt ? category.updatedAt|date('d/m/Y H\\hi') : '' }}</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>

    <div class="mt-3">
    {{ include('category/_delete_form.html.twig') }}

        <div class="mt-3">
            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-dark"><i class="bi bi-pencil-square" aria-hidden="true"></i> Modifier</a>
            {{ buttons.back_to_list('app_category_index') }}
        </div>
    </div>
{% endblock %}
