{% extends 'base.html.twig' %}

{% block title %}Catégories - {{ parent() }}{% endblock %}

{% block body %}
    <h1 class="mb-3">Catégories</h1>

    <div class="d-flex flex-column flex-lg-row gap-3 justify-content-between align-items-lg-center mb-3">
        <a href="{{ path('app_category_new') }}" class="btn btn-dark align-self-start align-self-lg-center ms-3"><i class="bi bi-plus-circle" aria-hidden="true"></i> Ajouter une catégorie</a>

        <form method="get" action="{{ path('app_category_index') }}" class="d-flex flex-column flex-sm-row gap-2 align-items-sm-center ms-lg-auto me-3">
            <label for="category-search" class="visually-hidden">Recherche par nom</label>
            <input type="search" id="category-search" name="q" value="{{ search }}" class="form-control" placeholder="Nom de la catégorie">
            <button type="submit" class="btn btn-dark text-nowrap"><i class="bi bi-search" aria-hidden="true"></i> Rechercher</button>
            {% if search %}
                <a href="{{ path('app_category_index') }}" class="btn btn-outline-dark text-nowrap">Réinitialiser</a>
            {% endif %}
        </form>
    </div>

   <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Parente</th>
                <th>Sous-catégories</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.name }}</td>
                <td>{{ category.parent ? category.parent.name : '-' }}</td>
                <td>
                    {% for child in category.children %}
                        {{ child.name }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        -
                    {% endfor %}
                </td>
                <td class="text-center">
                    <a href="{{ path('app_category_show', {'id': category.id}) }}" aria-label="Voir la catégorie {{ category.name }}" title="Voir" class="text-dark"><i class="bi bi-eye" aria-hidden="true"></i></a>
                    <a href="{{ path('app_category_edit', {'id': category.id}) }}" aria-label="Modifier la catégorie {{ category.name }}" title="Modifier" class="text-dark"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucune catégorie.</td>
            </tr>
        {% endfor %}
        </tbody>
        </table>
    </div>

    {% if categories.haveToPaginate() %}
        <div class="d-flex justify-content-center mt-4">
            {{ pagerfanta(categories, 'twitter_bootstrap5', {
                css_container_class: 'pagination pagination-sm pagination-dark mb-0',
                prev_message: 'Précédent',
                next_message: 'Suivant',
                routeParams: search ? {'q': search} : {}
            }) }}
        </div>
    {% endif %}
{% endblock %}
