<header class="mb-3">
<nav class="navbar navbar-expand-lg bg-dark" data-bs-theme="dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="{{ path('app_home') }}">{{ site_name }}</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="{{ path('app_home') }}">Accueil</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_product_index') }}">Produits</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_category_index') }}">Catégories</a>
        </li>
      </ul>
      <ul class="navbar-nav mb-2 mb-lg-0">
        {% if app.user %}
          <li class="nav-item"><span class="navbar-text me-3">{{ app.user.userIdentifier }}</span></li>
          <li class="nav-item">
            <form method="post" action="{{ path('app_logout') }}" class="d-inline">
              <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
              <button type="submit" class="nav-link"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Déconnexion</button>
            </form>
          </li>
        {% else %}
          <li class="nav-item">
            <a class="nav-link" href="{{ path('app_login') }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Connexion</a>
          </li>
        {% endif %}
      </ul>
      {#
      <form class="d-flex" role="search">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search"/>
        <button class="btn btn-outline-success" type="submit">Search</button>
      </form>
      #}
    </div>
  </div>
</nav>
</header>
