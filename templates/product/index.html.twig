{% extends 'base.html.twig' %}

{% block title %}Produits - {{ parent() }}{% endblock %}

{% block body %}
    <h1 class="mb-3">Produits</h1>

    <div class="d-flex flex-column flex-lg-row gap-3 justify-content-between align-items-lg-center mb-3">
        <a href="{{ path('app_product_new') }}" class="btn btn-dark align-self-start align-self-lg-center ms-3"><i class="bi bi-plus-circle" aria-hidden="true"></i> Ajouter un produit</a>

        <form method="get" action="{{ path('app_product_index') }}" class="d-flex flex-column flex-sm-row gap-2 align-items-sm-center ms-lg-auto me-3">
            <label for="product-search" class="visually-hidden">Recherche par nom</label>
            <input type="search" id="product-search" name="q" value="{{ search }}" class="form-control" placeholder="Nom du produit">
            <button type="submit" class="btn btn-dark text-nowrap"><i class="bi bi-search" aria-hidden="true"></i> Rechercher</button>
            {% if search %}
                <a href="{{ path('app_product_index') }}" class="btn btn-outline-dark text-nowrap">Réinitialiser</a>
            {% endif %}
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Prix</th>
                    <th>Stock</th>
                    <th>Catégories</th>
                    <th>Modifié le</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for product in products %}
                <tr>
                    <td>{{ product.id }}</td>
                    <td>{{ product.name }}</td>
                    <td class="text-end">{{ product.price }} &euro;</td>
                    <td class="text-end">{{ product.stock }}</td>
                    <td>
                        {% for category in product.categories %}
                            {{ category.name }}{% if not loop.last %}, {% endif %}
                        {% else %}
                            -
                        {% endfor %}
                    </td>
                    <td class="text-center">{{ product.updatedAt ? product.updatedAt|date('d/m/Y H\\hi') : '' }}</td>
                    <td class="text-center">
                        <a href="{{ path('app_product_show', {'id': product.id}) }}" aria-label="Voir le produit {{ product.name }}" title="Voir" class="text-dark"><i class="bi bi-eye" aria-hidden="true"></i></a>
                        <a href="{{ path('app_product_edit', {'id': product.id}) }}" aria-label="Modifier le produit {{ product.name }}" title="Modifier" class="text-dark"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Aucun produit trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if products.haveToPaginate() %}
        <div class="d-flex justify-content-center mt-4">
            {{ pagerfanta(products, 'twitter_bootstrap5', {
                css_container_class: 'pagination pagination-sm pagination-dark mb-0',
                prev_message: 'Précédent',
                next_message: 'Suivant',
                routeParams: search ? {'q': search} : {}
            }) }}
        </div>
    {% endif %}
{% endblock %}
