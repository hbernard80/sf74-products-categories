{% extends 'base.html.twig' %}

{% block title %}Ajouter un produit - {{ parent() }}{% endblock %}

{% block body %}
    {% import 'macros/buttons.html.twig' as buttons %}

    <h1 class="mb-3">Ajouter un produit</h1>

    {{ include('product/_form.html.twig', {'form_id': 'product-form'}) }}

    <div class="d-flex flex-wrap gap-2 align-items-center">
        <button type="submit" form="product-form" class="btn btn-primary">Enregistrer</button>
        {{ buttons.back_to_list('app_product_index') }}
    </div>
{% endblock %}
