parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    ignoreErrors:
        -
            message: '#^Property App\\Entity\\(Category|Product|User)::\$id \(int\|null\) is never assigned int so it can be removed from the property type\.$#'
            identifier: property.unusedType
            path: src/Entity/*
